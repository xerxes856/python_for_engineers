class Environment:
    def __init__(self, width=5, height=5, dirt_positions=None, obstacle_positions=None, goal_positions=None, sleep_time=0.5):
        self.sleep_time = sleep_time
        self.explored_positions = []
        self.width = width
        self.height = height
        self.dirt_positions = dirt_positions if dirt_positions is not None else []
        self.obstacle_positions = obstacle_positions if obstacle_positions is not None else []
        self.goal_positions = goal_positions if goal_positions is not None else []
        self.agent_position = (0, 0)

    def is_valid_position(self, position):
        x, y = position
        if x < 0 or y < 0 or x >= self.width or y >= self.height:
            return False
        if position in self.obstacle_positions:
            return False
        return True

    def get_percepts(self):
        return {
            "dirt": self.agent_position in self.dirt_positions,
            "goal": self.agent_position in self.goal_positions
        }

    def update_agent_position(self, action):
        x, y = self.agent_position
        moves = {
            "Up":    (x, y + 1),
            "Down":  (x, y - 1),
            "Left":  (x - 1, y),
            "Right": (x + 1, y)
        }
        if action in moves:
            new_pos = moves[action]
            if self.is_valid_position(new_pos):
                self.agent_position = new_pos

    def clean_dirt(self):
        if self.agent_position in self.dirt_positions:
            self.dirt_positions.remove(self.agent_position)

    def check_goal(self):
        return self.agent_position in self.goal_positions

    def mark_explored(self, position):
        if position not in self.explored_positions:
            self.explored_positions.append(position)

    def display(self):
        if self.sleep_time == 0:
            return
        fig, ax = plt.subplots(figsize=(self.width, self.height))
        ax.set_xticks(np.arange(0, self.width, 1))
        ax.set_yticks(np.arange(0, self.height, 1))
        ax.grid(True)
        ax.set_facecolor('lightgrey')
        for x, y in self.dirt_positions:
            ax.add_patch(plt.Rectangle((x, y), 1, 1, color="brown"))
        for x, y in self.obstacle_positions:
            ax.add_patch(plt.Rectangle((x, y), 1, 1, color="black"))
        for x, y in self.goal_positions:
            ax.add_patch(plt.Rectangle((x, y), 1, 1, color="green"))
        for x, y in self.explored_positions:
            ax.add_patch(plt.Rectangle((x, y), 1, 1, color="yellow"))
        ax.add_patch(plt.Rectangle(self.agent_position, 1, 1, color="blue"))
        plt.xlim(0, self.width)
        plt.ylim(0, self.height)
        sleep(self.sleep_time)
        clear_output(wait=True)
        plt.show()
