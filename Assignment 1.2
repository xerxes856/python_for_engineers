class A_Star_Agent(GBFS_Agent):
    def __init__(self, goal_position, env=None):
        super().__init__(goal_position=goal_position, env=env)

    def heuristic(self, position, steps_taken=0):
        x, y = position
        gx, gy = self.goal_position
        h = abs(x - gx) + abs(y - gy)
        return steps_taken + h

    def plan_path(self, start, goal):
        pq = PriorityQueue()
        pq.put((self.heuristic(start, 0), 0, start))
        came_from = {start: None}
        g_costs = {start: 0}
        visited = set()

        while not pq.empty():
            f, g, current = pq.get()

            if current in visited:
                continue
            visited.add(current)

            if self.env is not None:
                self.env.mark_explored(current)
                self.env.display()

            if current == goal:
                path_positions = []
                cur = current
                while cur is not None:
                    path_positions.append(cur)
                    cur = came_from[cur]
                path_positions.reverse()
                actions = []
                for i in range(len(path_positions)-1):
                    actions.append(self.get_direction(path_positions[i], path_positions[i+1]))
                return actions

            for neighbor in self.get_neighbors(current):
                if self.env is not None:
                    if not (0 <= neighbor[0] < self.env.width and 0 <= neighbor[1] < self.env.height):
                        continue
                    if not self.env.is_valid_position(neighbor):
                        continue
                tentative_g = g_costs[current] + 1
                if neighbor not in g_costs or tentative_g < g_costs[neighbor]:
                    g_costs[neighbor] = tentative_g
                    came_from[neighbor] = current
                    f_cost = self.heuristic(neighbor, tentative_g)
                    pq.put((f_cost, tentative_g, neighbor))
        return []
