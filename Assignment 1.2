from collections import deque

class GoalBasedAgent:
    def __init__(self, goal_position, strategy='BFS', env=None):
        self.plan = []
        self.goal_position = goal_position
        self.strategy = strategy
        self.env = env

    def get_neighbors(self, position):
        x, y = position
        return [(x, y+1), (x+1, y), (x, y-1), (x-1, y)]

    def get_direction(self, current, target):
        cx, cy = current
        tx, ty = target
        if tx > cx: return "Right"
        if tx < cx: return "Left"
        if ty > cy: return "Up"
        if ty < cy: return "Down"
        return None

    def plan_path(self, start, goal):
        if self.strategy == 'BFS':
            frontier = deque([start])
        else:
            frontier = [start]
        came_from = {start: None}

        while frontier:
            if self.strategy == 'BFS':
                current = frontier.popleft()
            else:
                current = frontier.pop()

            if self.env is not None:
                self.env.mark_explored(current)
                self.env.display()

            if current == goal:
                path_positions = []
                cur = current
                while cur is not None:
                    path_positions.append(cur)
                    cur = came_from[cur]
                path_positions.reverse()
                actions = []
                for i in range(len(path_positions)-1):
                    actions.append(self.get_direction(path_positions[i], path_positions[i+1]))
                return actions

            for neighbor in self.get_neighbors(current):
                # bounds check
                if self.env is not None:
                    if not (0 <= neighbor[0] < self.env.width and 0 <= neighbor[1] < self.env.height):
                        continue
                    if not self.env.is_valid_position(neighbor):
                        continue
                if neighbor not in came_from:
                    came_from[neighbor] = current
                    frontier.append(neighbor)
        return []

    def act(self, position):
        if not self.plan:
            self.plan = self.plan_path(position, self.goal_position)
        if self.plan:
            return self.plan.pop(0)
        return "NoOp"
